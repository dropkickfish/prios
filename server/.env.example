DATABASE_URL=sqlite.db
PORT=3000

# Production: path to built client so server can serve the SPA (e.g. ../client/dist when run from server/).
# When set, the server serves the app and API from the same origin; leave unset for API-only dev.
# PUBLIC_DIR=../client/dist

# Google Calendar API Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://0.0.0.0:3000/api/auth/google/callback
