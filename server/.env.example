DATABASE_URL=sqlite.db
PORT=3000

# Production: path to built client so server can serve the SPA.
# When set, the server serves the app and API from the same origin.
# Leave unset for API-only dev (Vite dev server proxies /api → localhost:3000).
# PUBLIC_DIR=../client/dist

# ─── Authentication ────────────────────────────────────────────────────────────
# Set AUTH_ENABLED=true to enforce login. Without it, the app is open to anyone
# who can reach the server (safe behind Tailscale or a private network).
# AUTH_ENABLED=true

# Required when AUTH_ENABLED=true. Sign JWTs and cookies.
# Generate with: openssl rand -hex 32
# AUTH_SECRET=

# Restrict login to a single email address (single-user / self-hosted mode).
# Omit to allow any authenticated user (multi-user).
# AUTH_ALLOWED_EMAIL=you@example.com

# Session lifetimes (seconds). Defaults shown.
# SESSION_TTL=2592000        # refresh token / full session: 30 days
# SESSION_ACCESS_TTL=900     # access token (JWT in cookie): 15 minutes

# ─── OAuth Providers (configure at least one when AUTH_ENABLED=true) ──────────
# Enable any combination of providers. At least one must be set when auth is on.

# Google Login
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: https://your-domain.com/api/auth/google/callback
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# GitHub Login
# Create an OAuth app at: https://github.com/settings/developers
# Authorised callback URL: https://your-domain.com/api/auth/github/callback
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=
# AUTH_GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# Generic OIDC (Authentik, Keycloak, Dex, Gitea, etc.)
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_DISCOVERY_URL=https://auth.example.com/application/o/prios/.well-known/openid-configuration
# AUTH_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
# AUTH_OIDC_DISPLAY_NAME=Authentik

# ─── Proxy / Network trust ────────────────────────────────────────────────────
# When Prios sits behind oauth2-proxy or a reverse proxy on a different host,
# set the proxy's IP/CIDR here. Requests from these IPs are trusted and the
# X-Auth-Request-User forwarded header is accepted as proof of identity.
# TRUSTED_PROXIES=10.0.0.1,10.0.0.0/8

# Legacy global API key (still honoured for backwards compatibility).
# Prefer creating named Personal Access Tokens in Settings > API Keys instead.
# API_KEY=

# ─── Google Calendar (separate from login) ────────────────────────────────────
# Used for calendar sync only — independent of the auth providers above.
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Scopes needed: openid email calendar calendar.events
# Authorised redirect URI: https://your-domain.com/api/auth/google-calendar/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google-calendar/callback

# ─── Storage ──────────────────────────────────────────────────────────────────
# STORAGE_TYPE=local            # 'local' (default) or 's3'
# STORAGE_LOCAL_PATH=./data/uploads

# S3-compatible storage (set STORAGE_TYPE=s3 to activate):
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=                  # omit for AWS; set for MinIO / Cloudflare R2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
